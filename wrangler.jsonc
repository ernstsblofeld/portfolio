// Cloudflare Workers config: serves this folder as a static site
{
  "name": "portfolio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "mediamax.ch", "custom_domain": true },
    { "pattern": "www.mediamax.ch", "custom_domain": true }
  ]
}
